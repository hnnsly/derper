# Docker image name (used in docker-compose.yml)
IMAGE_NAME=YOUR_GITHUB_USERNAME/derper

# DERP Server Fully Qualified Domain Name
DERP_HOST=derp.example.com

# TLS Certificate Mode: letsencrypt | manual | none
# - letsencrypt: derper requests and manages ACME certs on port 80/443 directly
# - manual: derper looks for <DERP_HOST>.crt and <DERP_HOST>.key in DERP_CERT_DIR
# - none: plaintext HTTP, intended for use behind a reverse proxy (Caddy, Traefik, Nginx)
DERP_CERT_MODE=letsencrypt

# Primary listen address
DERP_ADDR=:443

# HTTP Port for ACME challenges and redirects (-1 to disable)
DERP_HTTP_PORT=80

# STUN relay toggle and UDP port
DERP_STUN=true
DERP_STUN_PORT=3478

# Tailscale client verification
# Set to false for Headscale networks (Headscale nodes cannot verify against tailscale.com)
DERP_VERIFY_CLIENTS=false

# Certificate and data storage directories
DERP_CERT_DIR=/app/certs
DERP_DATA_DIR=/app/data
DERP_CONFIG_PATH=/app/data/derper.key
